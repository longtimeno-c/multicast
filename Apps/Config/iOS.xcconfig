// Per-target settings for the iOS remote "Multicast Remote". Edit these here, never in
// project.pbxproj: the project file only says which targets exist and what they compile.
// Paths are relative to Apps/ (the project directory).

PRODUCT_BUNDLE_IDENTIFIER = io.github.longtimeno-c.multicast.remote
INFOPLIST_FILE = iOS/Info.plist
// App Groups: shares the chosen speakers and the broadcast's status with the broadcast
// extension (iPhone Only mode; see iOSBroadcast.xcconfig).
CODE_SIGN_ENTITLEMENTS = iOS/MulticastRemote.entitlements
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// Signing: the simulator needs none (ad hoc). A device build needs a team: create
// Apps/Config/Local.xcconfig (git-ignored, so no team id is ever committed) with
//   DEVELOPMENT_TEAM = <your team id>
// and build with `xcodebuild … -destination 'generic/platform=iOS' -allowProvisioningUpdates`,
// which lets Xcode register the two bundle ids and the App Group under that team.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"

// After Local.xcconfig, which may set an identity meant for the Mac app.
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -

// The app icon: Apps/Shared/Assets.xcassets, drawn by Apps/Scripts/make-icon.swift.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
