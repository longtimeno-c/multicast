<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export compliance: the link to the Mac (ChaCha20-Poly1305, Curve25519) and AirPlay's
	     own handshake use only the operating system's standard cryptography (CryptoKit), which
	     Apple treats as exempt from export documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- "This iPhone" as a speaker of the Mac's group keeps playing with the screen locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Tuning speaker sync: the iPhone listens for a short test sound next to a speaker. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Multicast Remote listens for a short test sound while you tune a speaker's sync, to measure when the speaker is heard. Nothing is recorded, kept or sent: only the timing goes to your Mac.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Multicast Remote finds the Mac that plays your music and controls it over your network. In iPhone Only mode it finds your AirPlay speakers and plays to them.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_multicast-hub._tcp</string>
		<string>_raop._tcp</string>
		<string>_airplay._tcp</string>
	</array>
</dict>
</plist>
